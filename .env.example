APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onesolution_erp
DB_USERNAME=root
DB_PASSWORD=

# Tenancy (config/tenancy.php). House partner = direct clients; branding is data.
HOUSE_PARTNER_NAME="One Solutions"
HOUSE_PARTNER_SLUG=house
PLATFORM_DEFAULT_COUNTRY=BD
PLATFORM_DEFAULT_LOCALE=en
PLATFORM_DEFAULT_CURRENCY=BDT
PLATFORM_DEFAULT_REGION=bd
PLATFORM_DEFAULT_PLAN=starter

# Module system (config/platform_modules.php)
MODULES_CACHE_TTL_MINUTES=1440
MODULES_CONSENT_TERMS_VERSION=2026-09

# House brand for the browser app (config/branding.php); partners override it
# in their own settings. Phase 5B moves branding into partner data.
BRAND_PRIMARY_COLOR="#2B4C9B"
BRAND_SUPPORT_EMAIL=
# Images served by this site (public/). Defaults: /brand/house/logo.png, mark.png
# BRAND_LOGO_URL=/brand/house/logo.png
# BRAND_MARK_URL=/brand/house/mark.png

# Rule engine (config/platform_rules.php). Business values are rules, set with
# `php artisan rules:set` or the rules API — not environment variables.
RULES_CACHE_TTL_MINUTES=1440

# The browser app signs in with this session cookie (HttpOnly, SameSite=Lax).
# Production: SESSION_SECURE_COOKIE=true (HTTPS only) and SESSION_ENCRYPT=true.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Hosts whose browser requests to /api use the session cookie (the app's own
# domain). Unset = APP_URL plus localhost; an empty value would disable it.
# SANCTUM_STATEFUL_DOMAINS=erp.example.com
# Local demo partner (DemoPartnerSeeder):
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,erp.acme.localhost:8000,sunrise.acme.localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Self-serve sign-up (Phase 5C). Production needs a bot check, else sign-up stays closed.
BOT_CHECK_DRIVER=none
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Local only: the SMS log driver also writes the text, to read sign-up codes.
SMS_LOG_TEXT=false

# Online payments (Phase 5C-2): SSLCommerz SANDBOX only (developer.sslcommerz.com).
# Empty = no online payment offered. Never takes payments in production.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform hardening (config/security.php, Phase 8-2). Check a server with
# `php artisan security:check` on every deploy (fails in production while unsafe).
# Production: APP_ENV=production, APP_DEBUG=false, https APP_URL, LOG_LEVEL=warning,
# a dedicated DB user (docs/ops/db-least-privilege.md). Rotate APP_KEY with APP_PREVIOUS_KEYS.
SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
# General /api limits per minute (placeholders until real traffic is measured).
SECURITY_API_PER_USER=120
SECURITY_API_PER_ORGANIZATION=600
SECURITY_API_PER_IP=300
# Behind a load balancer: its addresses (comma-separated), so limits and logs see
# the real client address. Empty = trust no proxy.
TRUSTED_PROXIES=

# Encrypted backups (docs/ops/backups.md). Keys: base64 of 32 bytes, from
# `php artisan backup:run --generate-key`; keep a copy OFFLINE. To rotate, add
# BACKUP_KEY_V2 and set BACKUP_KEY_VERSION=v2; keep V1 while old sets exist.
BACKUP_DISK=backups
BACKUP_KEEP=14
BACKUP_KEY_VERSION=v1
BACKUP_KEY_V1=
# The monthly restore drill writes ONLY into this separate, empty database.
BACKUP_DRILL_DATABASE=
# Paths to the dump tools when they are not on PATH (e.g. Laragon on Windows):
# BACKUP_MYSQLDUMP=C:/laragon/bin/mysql/mysql-8.0.40-winx64/bin/mysqldump.exe
# BACKUP_MYSQL=C:/laragon/bin/mysql/mysql-8.0.40-winx64/bin/mysql.exe

# Audit log (config/audit.php, Phase 9-1): copy every entry to an external store.
# none | log (JSON lines in storage/logs/audit.log for the log collector)
AUDIT_SHIP_DRIVER=none

# Monitoring (config/monitoring.php, Phase 9-2): who hears about security alerts.
# Comma-separated; each channel takes alerts from its minimum severity (low|medium|high).
MONITORING_MAIL_TO=
MONITORING_SLACK_WEBHOOK=
MONITORING_SMS_TO=
# GET /internal/health with "Authorization: Bearer <token>"; empty = no endpoint.
HEALTH_TOKEN=

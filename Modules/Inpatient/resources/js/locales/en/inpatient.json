        "admissions": {
            "title": "Working with admitted patients",
            "steps": {
                "1": "Open the patient.",
                "2": "Doctors add round notes; nurses add vitals and medicines given.",
                "3": "\"Tests\" to send tests to the lab if needed.",
                "4": "\"Move bed\" to transfer."
            },
            "tips": {
                "1": "Notes are never changed or removed: write a new one to correct."
            }

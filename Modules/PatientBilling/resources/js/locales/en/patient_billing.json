    "guide": {
        "bills": {
            "title": "How to bill a patient and take money",
            "steps": {
                "1": "Tap \"New bill\" and find the patient.",
                "2": "Add services; charges from other departments come in by themselves.",
                "3": "Giving a discount? Write the reason.",
                "4": "Take the money: full, part or from the advance.",
                "5": "Finalize and print the receipt."
            },
            "tips": {
                "1": "Money before a bill (admission) is an advance; it pays later bills."
            },
            "mistakes": {
                "1": "Bills cannot be deleted. Before finalizing take a wrong line off; after, give a refund."
            },
            "settings": "Discount limit, dues and number prefixes are in the Patient billing settings."
        },
        "approvals": {
            "title": "How to approve discounts",
            "steps": {
                "1": "Open a waiting request.",
                "2": "Read the reason, then approve or reject."
            },
            "tips": {
                "1": "You cannot approve your own request.",
                "2": "Refunds are given from the bill by people allowed to approve."
            }
        },
        "cash": {
            "title": "How to close the cash",
            "steps": {
                "1": "In the morning, open the day with the change in the drawer.",
                "2": "At the end, count the cash and enter it.",
                "3": "Within the limit it closes; beyond it, a supervisor reviews."
            },
            "mistakes": {
                "1": "Cash cannot be taken until your day is open."
            },
            "settings": "The allowed difference is in the Patient billing settings."
        }
    }

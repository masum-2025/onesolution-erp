            "tips": {
                "1": "ওপরের ঘরে টিউবের barcode scan করলে তার order খোলে।"
            },
            "settings": "রিপোর্টের সময় আর নম্বরের অক্ষর ডায়াগনস্টিক-এর সেটিংসে আছে।"
        },
        "bench": {
            "title": "নমুনা নেবেন, ফল লিখবেন ও যাচাই করবেন যেভাবে",
            "steps": {
                "1": "\"নমুনা নিন\", তারপর label print করে টিউবে লাগান।",
                "2": "টিউব scan করে প্রতিটা ঘরে ফল লিখুন; রাখলে সীমার বাইরের ফলে চিহ্ন বসে।",
                "3": "অন্য একজন খুলে \"যাচাই ও সই\" (বা \"ফেরত পাঠান\") চাপবেন।",
                "4": "সব test যাচাই হলে রিপোর্ট print করে দেওয়া হয়েছে চিহ্ন দিন।"
            },
            "tips": {
                "1": "সইয়ের পর বদলালে নতুন সংশোধন হয়, পুরোনো ফলও থাকে।"
            },
            "mistakes": {
                "1": "Label লাগানোর আগে রোগীর নাম মিলিয়ে নিন।",
                "2": "নমুনা জমাট বা কম হলে \"নমুনা বাতিল\" করে নতুন নিন।"
            }
        },
        "parameters": {
            "title": "Test-এর ঘর ঠিক করবেন যেভাবে",
            "steps": {
                "1": "Test বাছুন।",
                "2": "প্রতিটা ঘর তার এককসহ যোগ করুন।",
                "3": "লিঙ্গ ও বয়স অনুযায়ী স্বাভাবিক সীমা দিন (নবজাতক দিন হিসাবে)।",
                "4": "রাখুন।"
            },
            "tips": {
                "1": "দেওয়া সীমাগুলো শুরু মাত্র: আপনার pathologist মিলিয়ে নেবেন।"
            }
        },
        "commission": {
            "title": "Referral ডাক্তারকে কীভাবে কমিশন দেবেন",
            "steps": {
                "1": "প্রতিটি ডাক্তারের রেকর্ডে তাঁর % দিন (খালি = নিয়মে দেওয়া সাধারণ %)।",
                "2": "রোগীর বিল চূড়ান্ত হলে কমিশন নিজে থেকেই হিসাব হয়।",
                "3": "মাস শেষে ডাক্তার খুলুন, order মিলিয়ে \"পরিশোধ লিখুন\" চাপুন।",
                "4": "ভুল হলে? সেই order-এর লাইন কারণ লিখে \"ফেরত নিন\"।"
            },
            "tips": {
                "1": "কিছুই মোছা হয় না: ফেরত নেওয়া লাইন আর প্রতিটি পরিশোধ রেকর্ডে থাকে, Accounting চালু থাকলে খাতায়ও যায়।"

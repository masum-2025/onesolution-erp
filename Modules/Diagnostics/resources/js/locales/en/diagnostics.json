    "guide": {
        "orders": {
            "title": "How to order tests",
            "steps": {
                "1": "Tap \"New test order\" and find the patient.",
                "2": "Tick the tests (search by name or code).",
                "3": "Add the referring doctor if any.",
                "4": "\"Order and bill\" puts the tests on the patient's bill; take the money there."
            },
            "tips": {
                "1": "Scan a tube's barcode in the box above to open its order."
            },
            "settings": "Report times and number prefixes are in the Diagnostics settings."
        },
        "bench": {
            "title": "How to take samples, enter and verify results",
            "steps": {
                "1": "\"Take samples\", then print the labels and stick them on the tubes.",
                "2": "Scan the tube and type each value; out-of-range values are flagged when saved.",
                "3": "Someone else opens it and taps \"Verify and sign\" (or \"Send back\").",
                "4": "When every test is verified, print the report and mark it given."
            },
            "tips": {
                "1": "A change after signing is a new correction; the old values stay on record."
            },
            "mistakes": {
                "1": "Check the patient's name before sticking a label.",
                "2": "A clotted or too-small sample: \"Reject sample\" and take a new one."
            }
        },
        "parameters": {
            "title": "How to set up a test's values",
            "steps": {
                "1": "Pick the test.",
                "2": "Add each value with its unit.",
                "3": "Add normal ranges by sex and age (newborns in days).",
                "4": "Save."
            },
            "tips": {
                "1": "The sample ranges given are a start: your pathologist checks them."
            }
        }
    }
